# Secrets and key material. The original 2024 Dockerfile was ignored alongside these
# because it had a TLS key baked into it. The committed Dockerfiles take their
# configuration from the environment instead, so they belong in the repository.
.env
src/.env
src/newserver/.env
src/groceryfrontend/.env
*.pem
*.key

# Build artefacts
src/groceryfrontend/myimage.tar
node_modules/
src/groceryfrontend/node_modules/
src/newserver/node_modules/

# Runtime scan data. data.json is committed as sample data; anything the services
# write beyond it is local state.
src/newserver/tmp.*.json

# Source documents for the committed PDFs, and the raw demo recording
GroceryDemo.mov
UI Test Results.docx
System Architecture Document.docx

# macOS
.DS_Store

# GitGuardian scanner cache
.cache_ggshield
