# Copy to .env and fill in. Never commit the real .env.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grocerydb?retryWrites=true&w=majority
CUSTOMER_NUMBER=1234

# How often scans are turned into stock movements, in milliseconds.
# Defaults to 60000 (one minute). Lower it when demonstrating or testing.
PROCESS_INTERVAL_MS=60000
